PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/prepai
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-secure-secret
JWT_EXPIRES_IN=7d

# AI_PROVIDER must be explicitly configured in production.
# Use "ollama" for local development or "openai" for hosted OpenAI-backed deployments.
AI_PROVIDER=ollama
AI_RESUME_ANALYSIS_MAX_CHARS=12000

# Required only when AI_PROVIDER=openai.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REQUEST_TIMEOUT_MS=30000
OPENAI_RESUME_ANALYSIS_MAX_CHARS=12000

# Required only when AI_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_REQUEST_TIMEOUT_MS=30000
